# --- Database ----------------------------------------------------------------
# docker compose sets this for you.
# "embedded" starts a private Postgres from the pgserver package (pip install -r requirements-dev.txt).
DATABASE_URL=postgresql://analytics:analytics@localhost:5432/analytics
EMBEDDED_DB_DIR=data/pgdata
# Create the sales schema and generate the demo data on first start
AUTO_SEED=true

# --- Query safety ------------------------------------------------------------
# Generated SQL runs as this NOLOGIN role (SELECT on the sales tables, no PII columns),
# inside a READ ONLY transaction. Created by the seed. Empty = run as the login user,
# which is only safe if that user is itself read-only.
QUERY_ROLE=sqlchat_reader
STATEMENT_TIMEOUT_MS=5000
MAX_ROWS=1000
# Refuse queries whose EXPLAIN cost estimate is above this (catches accidental cross joins).
# Empty disables the check.
MAX_QUERY_COST=5000000

# --- Model ---------------------------------------------------------------------
# Without a key (or base URL) the app uses the offline rule-based parser.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
# Any OpenAI-compatible server instead of OpenAI, e.g. Ollama:
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   CHAT_MODEL=qwen2.5-coder:7b
#   LLM_JSON_MODE=json_object
OPENAI_BASE_URL=
# json_schema (strict structured outputs, OpenAI) or json_object (Ollama and most others)
LLM_JSON_MODE=json_schema
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# auto = the LLM when OPENAI_API_KEY or OPENAI_BASE_URL is set, otherwise offline
GENERATOR=auto
# Times a failing query goes back to the model with the error
MAX_REPAIRS=2
FEW_SHOT_EXAMPLES=4
HISTORY_TURNS=4

# The date "last month" and "this year" are relative to. Empty = the latest order date,
# so the bundled data never goes stale.
REFERENCE_DATE=
ENCODE_TOKEN=enabled
LOAD_CONFIG=enabled
ENCODE_TOKEN=enabled
LOAD_CONFIG=enabled